{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "hatch fmt {file_path}",
        "description": "Format file with hatch fmt (ruff)",
        "filePattern": "*.py"
      },
      {
        "command": "hatch -e types run basedpyright {file_path}",
        "description": "Type check with basedpyright",
        "filePattern": "*.py"
      }
    ]
  }
}
